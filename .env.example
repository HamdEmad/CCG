# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# API key for the LLM provider (e.g. Gemini via OpenAI-compatible endpoint, or OpenAI/local proxy)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=models/gemini-3.1-flash-lite
LLM_MIN_INTERVAL_SECONDS=4.0

# ==============================================================================
# Web Scraping Configuration
# ==============================================================================
# Bearer token for Jina Reader API (https://jina.ai/reader)
JINA_API_KEY=your_jina_api_key_here

# ==============================================================================
# Search Provider Configuration (Hybrid Fallback)
# ==============================================================================
# Select a specific provider ('google_cse', 'serp', 'firecrawl', 'tavily', 'duckduckgo', 'jina')
# or 'auto' to use the default multi-engine hybrid fallback chain.
SEARCH_PROVIDER=auto
SEARCH_MAX_RESULTS=10
SEARCH_INTER_REQUEST_DELAY_SECONDS=2.0

# Google Custom Search JSON API (optional)
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_CX=your_google_cse_cx_id_here

# SerpAPI Google Search (https://serpapi.com - 250 free searches/month)
SERP_API_KEY=your_serp_api_key_here

# Firecrawl Search API (https://firecrawl.dev - 1,000 requests/month)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Tavily Search API (https://tavily.com - 1,000 free requests/month)
TAVILY_API_KEY=your_tavily_api_key_here

# ==============================================================================
# Browser Automation & Feature Toggles
# ==============================================================================
ENABLE_SITE_SEARCH=true
ENABLE_SERIES_FALLBACK=true
BROWSER_HEADLESS=true

# Execution tier: 'customer_urls', 'web_search', 'url_inference', 'browser_automation', or 'auto'
PIPELINE_TIER=auto

# ==============================================================================
# Stage-First Orchestrator & Persistence Settings
# ==============================================================================
# Set to true to keep per-message state files on disk for debugging / crash recovery
PIPELINE_WORKSPACE_PERSISTENT=false
PIPELINE_WORKSPACE_DIR=data/pipeline_workspace
PIPELINE_MAX_WORKERS=4

# ==============================================================================
# Observability (Optional)
# ==============================================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Customer Cycle Graph
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
